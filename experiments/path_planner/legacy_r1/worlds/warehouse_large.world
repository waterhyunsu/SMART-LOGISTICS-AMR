<?xml version="1.0"?>
<!-- tools/make_warehouse_world.py 로 만든 월드: warehouse_large
     물류 창고 40 x 30 m: 랙 구역 3개(x 3~11, 14~22, 25~33), 랙 27개(길이 8 m, 깊이 1.0 m, 높이 2.0 m), 랙 사이 통로 1.5 m,
     y=15.5 주 통로 4 m, 구역 사이 통로 3 m (기둥 4개), 서쪽 통로 3 m, 동쪽 하역장 7 m (팔레트 4개). 홈 = (37, 15.5) -->
<sdf version="1.6">
  <world name="warehouse_large">
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros><namespace>/</namespace></ros>
      <update_rate>20.0</update_rate>
    </plugin>
    <include><uri>model://ground_plane</uri></include>
    <include><uri>model://sun</uri></include>
    <scene>
      <shadows>false</shadows>
    </scene>
    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>
    <model name="wall_s">
      <static>true</static>
      <pose>20.000 -0.050 0.250 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>40.200 0.100 0.500</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>40.200 0.100 0.500</size></box></geometry><material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
      </link>
    </model>
